{
  "name": "vanity-grinder-web",
  "version": "2.0.0",
  "description": "Zero-network, 100% client-side Solana vanity address generator (browser).",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DoradoDevs/solana-vanity-address-generator.git",
    "directory": "web"
  },
  "scripts": {
